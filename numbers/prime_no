package numbers;

public class prime_no {

	public static void main(String[] args) {
		int count=0;
		int num=11;
		for(int i=1;i<=num;i++)
		{
			if(num%i==0)
			{
				count++;
			}
		}
		if(count>2)
		{
			System.out.println("Not Prime");
		}
		else
		{
			System.out.println(" Prime");
		}

	}

}
